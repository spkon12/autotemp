[Unit]
Description=autotemp temperature receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=batthumb
Group=batthumb
WorkingDirectory=/home/batthumb/esp32-temperature-search/server
Environment=AUTOTEMP_HOST=0.0.0.0
Environment=AUTOTEMP_PORT=8080
Environment=AUTOTEMP_DB_PATH=/home/batthumb/services/autotemp-data/readings.db
Environment=AUTOTEMP_LOG_LEVEL=INFO
ExecStart=/home/batthumb/esp32-temperature-search/server/.venv/bin/python app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
